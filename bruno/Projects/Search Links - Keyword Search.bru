meta {
  name: Search Links - Keyword & Text Search
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/api/projects/{{projectId}}/search
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "url_contains": "doc",
    "anchor_contains": "",
    "limit": 30,
    "offset": 0
  }
}

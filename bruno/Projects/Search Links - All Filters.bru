meta {
  name: Search Links - All Filters
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/projects/{{projectId}}/search
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "link_type": "internal",
    "http_status_min": 200,
    "http_status_max": 299,
    "http_statuses": [200, 301],
    "custom_statuses": [0],
    "is_nofollow": false,
    "depth_levels": [1, 2],
    "url_contains": "",
    "url_starts_with": "",
    "url_ends_with": "",
    "parent_url": "",
    "anchor_contains": "",
    "limit": 50,
    "offset": 0
  }
}
